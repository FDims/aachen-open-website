.homepage {
    display: flex;
    flex-direction: column;
    margin: auto;
    .homepage-description{
        flex: auto;
        background-color: var(--blue2);
        display: flex;
        flex-direction: row;
        width: 85%;
        margin: 3vh auto;
        padding: 20px;
        border-radius: 10px;
        align-items: center;
        .homepage-description-image {
            flex: auto;
            display: inline-flex;
            height: 15%;
            width: 15%;
            max-width: 500px;
            align-items: center;
            .homepage-description-image-logo {
                margin: 0 auto;
                max-height: 300px;
                max-width: 300px;
            }
        }
        .homepage-description-text {
            flex: 2;
            margin: auto 15px;
            font-family: "helvetica world", helvetica, arial, sans-serif;
            width: 45%;
            h5{
                font-size: 30px;
                font-weight: bolder;
                margin: 10px;
            }
            h3{
                font-size: 20px;
                font-weight: bold;
                margin: 10px;
            }
            p{
                text-align: justify;
                margin: 10px;
            }
        }
        .homepage-description-infos {
            flex: 1;
            margin: auto 10px;
            width: 25%;
            .homepage-infos-date, .homepage-infos-location, .homepage-infos-instagram{
                display: flex;
                flex-direction: row;
                margin: 15px 0;
            }
            .homepage-infos-date-icon, .homepage-infos-location-icon, .homepage-infos-instagram-icon{
                height: 20px;
                margin: auto 0;
            }
            .homepage-infos-date-text, .homepage-infos-location-text, .homepage-infos-instagram-text{
                display: inline-flex;
                margin: 0 10px;
            }
        }
    }

    .homepage-schedule-cards-wrapper {
        width: 100%;
        flex: auto;

        .homepage-schedule-cards-title{
            width: 90%;
            justify-content: space-between;
            display: flex;
            flex-direction: row;
            .homepage-schedule-cards-title-text{
                font-size: 3vh;
                font-weight: bolder;
                margin: 0 10vw;
                display: inline-block;
            }
            .homepage-schedule-cards-redirect{
                font-size: 2vh;
                display: inline-block;
                position: relative;
                right: 0;
                align-content: center;
            }

            @media (max-width: 768px) {
                .homepage-schedule-cards-title-text{
                   font-size: 4vw ;
                }
                .homepage-schedule-cards-redirect{
                    font-size: 3vw;
                }
            }
        }

        .homepage-schedule-cards {
            background-color: white;
            width: 85%  ;
            border: 2px solid var(--cream);
            border-radius: 10px;
            margin: auto;
            padding: 40px 0 10px 0;
            @media (max-width: 940px) {
                padding: 10px 0;
            }

            .homepage-schedule-coming-soon{
                height: 15vh;
                font-size: 30px;
                font-weight: bolder;
                text-align: center;
            }
        }
        .homepage-schedule-swipe-text{
            font-size: 1.5vh;
            margin: 0 auto;
            text-align: center;
        }
    }
}

.homepage-organizers, .homepage-sponsors{
    margin: 1vh 7vw;
}

@media (max-width: 940px) {
    .homepage{
        flex-direction: column-reverse;
        .homepage-description {
            flex-direction: column;
            .homepage-description-image, .homepage-description-text, .homepage-description-infos{
                width: 100%;
            }
        }
    }
}
