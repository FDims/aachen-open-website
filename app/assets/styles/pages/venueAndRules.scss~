.wrapper {
  margin: 10px auto;
  width: 60vw;
  @media (max-width: 940px) {
    width: 90vw;
  }
}

.title{
  font-size: 50px;
  font-weight: bold;
  text-align: center;
}

.images {
  height: 50vw;
  margin: 10px auto;
  @media (max-width: 940px) {
    height: 90vw;
  }
}

.location-link{
  display: flex;
  flex-direction: row;
  justify-content: center;
  font-size: 24px;
  margin: auto 20px;

  @media (max-width: 940px) {
    font-size: 10px;

  }

  .location-icon {
    height: 20px;
    margin: auto 10px;
  }
}

.vendor-carousel{
  img{
    width: 60%;
    margin: auto;
  }
}