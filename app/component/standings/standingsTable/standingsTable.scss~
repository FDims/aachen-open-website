.standings-table {
  padding: 3vh 3vw;
  background-color: var(--cream);
  .standings-table-title {
    font-size: 2.5vh;
    text-align: center;
    font-weight: bold;
  }
  .standings-table-data{
    font-size: 1.5vw;
    thead {
      border: none;
    }
    th {
      border-bottom: 1px solid lightgray;
    }
  }
}