.matchCard-wrapper{
    margin: 20vh 2vw;
    border: 2px solid var(--cream);
    border-radius: 5%;
    align-items: center;
    justify-items: center;
    text-align: center;
    background-color: var(--blue2);
    max-width: 40vh;
    .matchCard-team-name {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 1vh;
        .match-card-team-a, .match-card-team-b{
            display: inline-flex;
            margin: 0 1vw;
            font-weight: bold;
            font-size: 20px;
            width: auto;
        }
    }

    .matchCard-team-score {
        .match-card-score-a, .match-card-score-b{
            display: inline-flex;
            flex-direction: column;
            margin: 0 5vw;
        }
    }
}