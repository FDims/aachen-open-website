.match-card-wrapper{
    margin: 10px 2vw;
    border-radius: 10px;
    align-items: center;
    justify-items: center;
    text-align: center;
    width: 20vw;
    height: 25vh;


    .match-card-header {
        display: flex;
        flex-direction: row;
        .match-card-header-logo{
            margin: auto 10px;
            width: 30px;
            height: 30px;
        }
        .match-card-header-text {
            display: inline-flex;
            font-size: 25px;
            margin: auto;
        }
    }
    .match-card-body{
        display: flex;
        flex-direction: row;
        margin: auto;
        width: 100%;
        overflow: clip;
        .match-card-team-home,.match-card-team-away {
            display: flex;
            flex-direction: row;
            margin: auto;
            max-width: 40%;
            .match-card-name-home,
            .match-card-name-away {
                margin: auto;
                font-size: 25px;
            }
            .match-card-score-away,
            .match-card-score-home {
                margin: auto 5px;
                font-size: 40px;
            }
        }

        p{
            font-weight: bold;
            font-size: 30px;
            margin: auto;
            color: var(--red1);
        }
    }
    .match-card-footer{
        display: flex;
        flex-direction: row;
        .match-card-footer-circle {
            margin: auto 5px;
            height: 20px;
            width: 20px;
            border-radius: 50%;
            &.-finished{
                background-color: var(--cream);
            }
            &.-live{
                background-color: #00DC82;
            }
            &.-upcoming{
                background-color: var(--red2);
            }
        }
        .match-card-footer-status{
            font-size: 30px;
            &.-finished{
                color: var(--cream);
            }
            &.-live{
                color: #00DC82;
            }
            &.-upcoming{
                color: var(--red2);
            }
        }
    }
}